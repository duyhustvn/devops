# ==============================================================================
# Sentry Custom Environment Overrides (.env.custom)
# Copy file này thành .env.custom để áp dụng các thiết lập riêng vào self-hosted/.env
# ==============================================================================

# 1. Cấu hình IP và Port mà Sentry Web lắng nghe (Mặc định: 127.0.0.1:9000 hoặc 0.0.0.0:9000)
SENTRY_BIND=0.0.0.0:9000

# 2. Thời gian lưu trữ dữ liệu sự kiện (Retention Days)
# Rất quan trọng với VM có dung lượng ổ đĩa hạn chế! Mặc định là 90 ngày.
# Khuyến nghị: 14 hoặc 30 ngày để tiết kiệm dung lượng ClickHouse & PostgreSQL.
SENTRY_EVENT_RETENTION_DAYS=30

# 3. Cấu hình gửi Mail qua SMTP (để Sentry gửi email cảnh báo lỗi và mời thành viên)
SENTRY_MAIL_HOST=smtp.gmail.com
SENTRY_MAIL_PORT=587
SENTRY_MAIL_USERNAME=your-email@gmail.com
SENTRY_MAIL_PASSWORD=your-app-password
SENTRY_MAIL_USE_TLS=true
SENTRY_MAIL_USE_SSL=false
SENTRY_MAIL_FROM=sentry-alerts@yourdomain.com

# 4. Tùy chọn tag phiên bản Sentry cụ thể (Nếu muốn cố định phiên bản)
# SENTRY_IMAGE_TAG=latest
