# ==============================================================================
# Sentry Custom Environment Configuration (.env hoặc .env.custom)
# Copy file này thành .env (hoặc .env.custom) trước khi chạy ./deploy.sh
# ==============================================================================

# 1. URL gốc truy cập Sentry (BẮT BUỘC - Dùng để cấu hình system.url-prefix và chống lỗi CSRF Token)
# Đặt đúng URL/IP bạn gõ trên trình duyệt (phải có http:// hoặc https://, không có dấu / ở cuối)
# Ví dụ VM IP: http://192.168.56.101:9000
# Ví dụ Domain qua HTTPS: https://sentry.yourdomain.com
SENTRY_URL_PREFIX=http://127.0.0.1:9000

# 2. Cấu hình IP và Port mà Sentry Web lắng nghe (Mặc định: 0.0.0.0:9000)
SENTRY_BIND=0.0.0.0:9000


# 3. Thời gian lưu trữ dữ liệu sự kiện (Retention Days)
# Rất quan trọng với VM có dung lượng ổ đĩa hạn chế! Mặc định là 90 ngày.
# Khuyến nghị: 14 hoặc 30 ngày để tiết kiệm dung lượng ClickHouse & PostgreSQL.
SENTRY_EVENT_RETENTION_DAYS=14

# 4. Cấu hình gửi Mail qua SMTP (để Sentry gửi email cảnh báo lỗi và mời thành viên)
SENTRY_MAIL_HOST=smtp.gmail.com
SENTRY_MAIL_PORT=587
SENTRY_MAIL_USERNAME=your-email@gmail.com
SENTRY_MAIL_PASSWORD=your-app-password
SENTRY_MAIL_USE_TLS=true
SENTRY_MAIL_USE_SSL=false
SENTRY_MAIL_FROM=sentry-alerts@yourdomain.com

# 5. Tùy chọn tag phiên bản Sentry cụ thể (Nếu muốn cố định phiên bản)
# SENTRY_IMAGE_TAG=latest

