services:
  clickhouse:
    image: {{ clickhouse_image }}
    container_name: dwh-clickhouse-{{ inventory_hostname }}
    hostname: {{ inventory_hostname }}
    restart: unless-stopped
    network_mode: host
    environment:
      CLICKHOUSE_DB: {{ clickhouse_db }}
      CLICKHOUSE_USER: {{ clickhouse_user }}
      CLICKHOUSE_PASSWORD_FILE: /run/secrets/clickhouse_password
      CLICKHOUSE_DEFAULT_ACCESS_MANAGEMENT: 1
    secrets:
      - clickhouse_password
    ulimits:
      nofile:
        soft: 262144
        hard: 262144
    volumes:
      - {{ clickhouse_deploy_dir }}/data:/var/lib/clickhouse
      - {{ clickhouse_deploy_dir }}/logs:/var/log/clickhouse-server
      - {{ clickhouse_deploy_dir }}/config.d:/etc/clickhouse-server/config.d:ro

secrets:
  clickhouse_password:
    file: {{ clickhouse_deploy_dir }}/secrets/clickhouse_password.txt
