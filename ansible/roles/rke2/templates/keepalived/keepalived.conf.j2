vrrp_script check_apiserver {
    script "/etc/keepalived/check_apiserver.sh"
    interval 3
    timeout 5
    weight -20
    fall 2
    rise 2
}

vrrp_instance VI_1 {
    state MASTER
    interface {{ vip_interface }}
    virtual_router_id 51
    priority {% if inventory_hostname == groups['master'][0] %}100{% else %}90{% endif %}
    advert_int 1
    authentication {
        auth_type PASS
        auth_pass {{ vip_password | default('securepass') }}
    }
    virtual_ipaddress {
        {{ vip }}/24
    }
    track_script {
        check_apiserver
    }
}

